# Chọn nhà cung cấp AI cho chatbot: ollama (mặc định) | openai-compatible | gemini
AI_PROVIDER=ollama

# --- ollama: miễn phí, không cần API key nếu tự chạy `ollama serve` ở máy/server riêng ---
# Bỏ trống OLLAMA_API_KEY khi dùng Ollama local — chỉ cần khi dùng Ollama Cloud.
OLLAMA_API_KEY=
# Model rẻ/nhanh: gpt-oss:20b · mạnh hơn: gpt-oss:120b, qwen3-coder:480b
OLLAMA_MODEL=llama3.1
# http://localhost:11434 nếu chạy Ollama local, hoặc https://ollama.com nếu dùng Ollama Cloud
OLLAMA_HOST=http://localhost:11434

# --- openai-compatible: dùng cho Groq (miễn phí), OpenRouter (có model free), hoặc
# server local như LM Studio/llama.cpp (không cần key) ---
AI_BASE_URL=https://api.groq.com/openai/v1
AI_MODEL=llama-3.1-8b-instant
AI_API_KEY=your_groq_or_openrouter_api_key

# --- gemini: Google AI Studio có gói miễn phí (https://aistudio.google.com/apikey) ---
GEMINI_API_KEY=your_gemini_api_key
GEMINI_MODEL=gemini-1.5-flash
